{{- /* Local override of PaperMod's rss.xml (theme 10d3dcc).

     What changed and why:
     - The home feed lists only dated writing (blog, lab notes, notes) and
       project pages. The theme's feed also carried About, Now, Reading,
       Contact and Thanks, each with <pubDate>Mon, 01 Jan 0001</pubDate>, which
       feed readers show as new items from the year 1.
     - Items are sorted newest first by date. The theme's list came out in
       weight order, so every project page preceded every post.
     - <language> reads .Language.Locale (LanguageCode is deprecated since
       Hugo 0.158).
     Section feeds (/blog/index.xml and so on) keep the theme's behaviour apart
     from the sort. */}}
{{- $authorName := site.Params.author | default site.Title }}
{{- $pctx := . }}
{{- if .IsHome }}{{ $pctx = site }}{{ end }}
{{- $pages := slice }}
{{- if .IsHome }}
  {{- $pages = where site.RegularPages "Section" "in" (slice "blog" "experiments" "notes" "projects") }}
{{- else if .IsSection }}
  {{- $pages = $pctx.RegularPages }}
{{- else }}
  {{- $pages = $pctx.Pages }}
{{- end }}
{{- $pages = where $pages "Date.IsZero" false }}
{{- $pages = $pages.ByDate.Reverse }}
{{- $limit := site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}
  {{- $pages = $pages | first $limit }}
{{- end }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ if eq .Title site.Title }}{{ site.Title }}{{ else }}{{ with .Title }}{{ . }} on {{ end }}{{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ if .IsHome }}{{ site.Params.description }}{{ else }}Recent content {{ with .Title }}in {{ . }} {{ end }}on {{ site.Title }}{{ end }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale | default "en-US" }}</language>
    {{- with $pages }}
    <lastBuildDate>{{ (index $pages.ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    {{- if and (ne .Layout `search`) (ne .Layout `archives`) }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ with .Description | html }}{{ . }}{{ else }}{{ .Summary | html }}{{ end -}}</description>
      {{- if and site.Params.ShowFullTextinRSS .Content }}
      <content:encoded>{{ (printf "<![CDATA[%s]]>" .Content) | safeHTML }}</content:encoded>
      {{- end }}
    </item>
    {{- end }}
    {{- end }}
  </channel>
</rss>
